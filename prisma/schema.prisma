model PurchaseOrder {
  id          String  @id @default(cuid())
  number      Int     @default(autoincrement())
  code        String
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId    String
  // Restrict, not Cascade: deleting a vendor must never silently destroy its
  // purchase orders (and their items, files, messages) behind the app's back.
  // deleteVendor blocks with a count; this is the backstop for every other caller.
  vendor      Vendor  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status      String  @default("Draft") // Draft, Sent, Received, Cancelled
  totalAmount Decimal @default(0)
  notes       String?
  memos       String?
  terms       String?

  sentAt   DateTime?
  viewedAt DateTime?

  approvedBy String?
  approvedAt DateTime?

  items             PurchaseOrderItem[]
  files             PurchaseOrderFile[]
  expenses          Expense[]
  messages          PurchaseOrderMessage[]
  /// @deprecated back-relation for the legacy single-PO link. See EstimateItem.purchaseOrderId.
  estimateItems     EstimateItem[]
  estimateItemLinks EstimateItemPurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([vendorId])
}

