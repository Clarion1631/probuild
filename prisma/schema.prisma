  suggestionSource        String? // "daily_log" | "today_schedule" | "user_history"
  suggestionOverridden    Boolean @default(false)

  mealSkipped        Boolean   @default(false)
  mealDeductionHours Float?
  needsReview        Boolean   @default(false)
  reviewReason       String?
  qbTimeActivityId   String?
  qbSyncedAt         DateTime? @db.Timestamp(6)

  @@index([projectId])
  @@index([userId])
  @@index([costCodeId])
  @@index([costTypeId])
  @@index([estimateItemId])
  @@index([scheduleTaskId])
  @@index([changeOrderId])
}

model Contract {
  id        String   @id @default(cuid())
  number    Int      @default(autoincrement())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  title  String
  body   String // HTML string of the legal agreement (with merge fields resolved)
  status String @default("Draft") // Draft, Sent, Viewed, Signed, Declined

  estimates Estimate[]

  // Signing fields (current/latest)
  approvedBy        String?
  approvedAt        DateTime?
  approvalIp        String?
  approvalUserAgent String?
  signatureUrl      String? // Supabase Storage URL of the drawn signature (legacy rows may hold an inline data-URL)

  // Contractor signing fields
  contractorSignedBy     String?
  contractorSignedAt     DateTime? @db.Timestamptz(6)
  contractorSignatureUrl String? // Supabase Storage URL of the contractor's drawn signature (legacy rows may hold an inline data-URL)

  // Company countersignature (executed AFTER the customer signs — see countersignContractAsCompany)
  requiresCountersign Boolean   @default(false) // when true, contract isn't Finalized until the company countersigns
  companySignedBy     String?
  companySignedAt     DateTime?
  companySignatureUrl String? // Supabase Storage URL of the company signature (NOT an inline data-URL)
  signedPdfPath       String? // Supabase Storage path of the client-signed intermediate PDF (held until countersign)
  originalPdfPath     String? // Supabase Storage path of the uploaded original PDF contract

  // Sending
  sentAt   DateTime?
  viewedAt DateTime?

  // Portal access token — stable magic-link for client to view/sign the contract without a login.
  // Generated on first send, preserved on resend so old email links keep working.
  accessToken String? @unique

  // Recurring (e.g. lien release every 30 days)
  recurringDays  Int? // null = one-time, 30 = every 30 days
  nextDueDate    DateTime? // When the next signing is due
  signingRecords ContractSigningRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([leadId])
}

model ContractSigningRecord {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  signedBy     String // Full legal name
  signedAt     DateTime @default(now())
  signatureUrl String? // Supabase Storage URL of the drawn signature (legacy rows may hold an inline data-URL)
  ipAddress    String?
  userAgent    String?

  periodStart DateTime? // Start of the period this release covers
  periodEnd   DateTime? // End of the period this release covers

  notes String? // Optional notes (e.g. payment amount)

  createdAt DateTime @default(now())

  @@index([contractId])
}

