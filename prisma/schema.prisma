// Durable outbox for milestone-paid notifications. A row is enqueued INSIDE the
// same transaction that settles a milestone, so it commits atomically with the
// payment; a drainer (inline fast-path + cron backstop) then delivers the team
// alert / client receipt / activity log exactly once. This closes the gap where a
// crash between commit and the old inline notify would drop the notification.
// No FK: scheduleId points at a PaymentSchedule (scheduleType "invoice") or an
// EstimatePaymentSchedule ("estimate"). Not unique — an undo + re-pay is a new
// event that must notify again.
model PaymentNotification {
  id                  String    @id @default(cuid())
  scheduleId          String
  scheduleType        String // "invoice" | "estimate"
  kind                String    @default("milestone_paid")
  status              String    @default("PENDING") // PENDING | PROCESSING | PROCESSED | FAILED
  attempts            Int       @default(0)
  lastError           String?
  // Fencing token: set on each claim, required by the completion update. A worker whose
  // lease expired (row re-claimed by another drainer) writes a stale token, so its late
  // completion no-ops instead of overwriting the new owner's result. Prevents double-finish.
  claimToken          String?
  processingStartedAt DateTime?
  createdAt           DateTime  @default(now())
  processedAt         DateTime?

  @@index([status])
  @@index([scheduleId])
}

