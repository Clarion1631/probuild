+/// Append-only audit trail for the customer-data recovery net (see SOFT_DELETE.md).
+/// On DELETE the `snapshot` captures the full row (and cascaded children) so the
+/// record is recoverable even after a later hard purge.
+model AuditLog {
+  id         String   @id @default(cuid())
+  entity     String // Model name, e.g. "Client", "Lead", "Project", "Estimate"
+  entityId   String // Primary key of the affected row
+  action     String // CREATE | UPDATE | DELETE | RESTORE
+  actorId    String? // User.id of the actor (null for dev/system actions)
+  actorEmail String? // Denormalized actor email so the log reads without a join
+  snapshot   Json? // Full row state (+ cascaded children) — captured on DELETE
+  createdAt  DateTime @default(now())
+
+  @@index([entity, entityId])
+  @@index([action])
+  @@index([createdAt])
 }
