# .vercelignore — replaces .gitignore for Vercel CLI deploys
# When this file exists, .gitignore is NOT used by Vercel.

# Dependencies (installed on Vercel's build machines)
node_modules

# Build output (rebuilt on Vercel)
.next
out
build

# Claude Code artifacts (worktrees alone are 20+ GB)
.claude

# Test/QA artifacts
test-results
qa-report
qa-screenshots
.playwright-mcp
e2e/.auth

# Large non-source directories
output
estimatesamples
graphify-out
.remember
scripts/vendor

# Environment / secrets
.env
.env.*
config.py
__pycache__

# Misc
.DS_Store
*.pem
.vercel
*.tsbuildinfo
coverage

# Local workspace folder (financial exports, not app source)
gtr-probuild

# Untracked scratch/reference files (not app source; Assets alone is 109MB and
# its ndjson/scripts crash Tailwind's source scanner on Vercel)
Assets
GoldenTouchRemodelingProjectBook.pdf
_review-round2.diff

# Gitignored locally but uploaded by CLI (Tailwind scans them on Vercel where
# no .git exists; the mangled Users* dir name has invalid-codepoint chars)
# ROOT-ANCHORED: an unanchored Users* also matched src/app/api/users at build
# time (case-insensitive), silently dropping the /api/users route from every
# deploy — the Team Members page showed "No team members found" because its
# API did not exist in prod. Anchor junk-dir patterns to the root.
.agents
.superpowers
playwright-report
_context
/Users*
*.ndjson

# Leftover one-off automation scripts in repo root; their raw Windows paths
# (\cbc3d5c2...) parse as out-of-range CSS escapes and crash Tailwind's scanner
pb6.mjs
pb7.mjs
