NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_strong_secret_here

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google Maps — browser key for Places autocomplete + map previews (referrer-restricted)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_maps_key_here
# Server key for Geocoding (address normalization at save) — must NOT be referrer-restricted
GOOGLE_MAPS_SERVER_API_KEY=your_server_maps_key_here

# Supabase Storage (for file uploads)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Help chat + GitHub automation
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPO=Clarion1631/probuild
PHANTOM_WEBHOOK_SECRET=generate_a_strong_random_secret_here

# Shared secret for the ChatGPT MCP connector (/api/mcp) — any long random string
MCP_SECRET=
# Optional: a second MCP key limited to the READONLY_TOOLS allowlist in the
# route (billing/schedule/file reads only, no create/update/delete/send).
# Leave unset to disable read-only mode entirely. Dedicated value: never reuse MCP_SECRET.
MCP_READONLY_SECRET=

# Bank-ledger automation: keep these separate; the posting-status key is read-only.
BANK_LEDGER_INGEST_SECRET=generate_a_strong_random_secret_here
BANK_LEDGER_STATUS_SECRET=generate_a_different_strong_random_secret_here
# Private reviewed bank-image upload only (/api/integrations/bank-images/ingest).
# Dedicated value: never reuse MCP, receipt, or bank-ledger credentials.
BANK_IMAGE_INGEST_SECRET=

# --- Receipt Pipeline v2 (docs/plans/PHASE-1-INTAKE-CORE-SPEC.md) ---
# THREE machine secrets, deliberately separate: they belong to different programs
# with different blast radii, and they rotate independently. Setting them to the
# SAME value is refused at runtime — that would silently re-merge the two.
#
# The Apps Script forwarders. May only INGEST (POST /api/receipts/intake,
# /start, /{id}/finalize) and only under source drive|email|chat. Cannot read
# the queue and cannot archive.
RECEIPT_INTAKE_SECRET=
# The nightly Drive archive mirror. May only READ BOOKED/ARCHIVED rows
# (GET /api/receipts/intake?state=BOOKED) and report back what it archived
# (POST /api/receipts/intake/{id}/archived). Cannot create or publish a row.
RECEIPT_ARCHIVE_SECRET=
# Beverly's Chat bridge (Phase 2 §4). May ONLY read live card threads
# (GET /api/automation/receipt-requests/threads) and record a SIGNED memo
# against one of our own fingerprints (POST .../answers). It cannot touch a
# ReceiptIntake row at all. It runs in someone else's Apps Script project, which
# is exactly why it is not the intake key.
RECEIPT_BRIDGE_SECRET=
#
# Storage note (not an env var): receipts live in their OWN private bucket,
# `receipt-intake`, carrying an 8 MiB file-size limit and an allow-list of the
# six formats QuickBooks can attach. Two-step uploads go straight to a signed
# URL and never pass through this server, so the bucket is the only place a
# too-large or wrong-type write can actually be refused; MAX_STORED_BYTES in
# src/lib/receipt-intake/intake-core.ts only lets the server reject the object
# after the fact. It is separate from `secure-docs` because those limits are
# per-bucket, and because a signed upload URL is a write capability that must
# not point at the bucket holding signed contracts.
#
# Do NOT create it by hand: scripts/apply-receipt-intake.mjs creates it when
# missing and VERIFIES it when present (it needs SUPABASE_URL and
# SUPABASE_SERVICE_KEY in the environment, and exits nonzero if the bucket
# exists with a different limit, MIME list, or public flag).
#
# Shadow mode. UNSET or "true" = dry run: rows are read, deduped and routed, and
# NOTHING is booked. Set to the literal "false" only at cutover.
RECEIPT_INTAKE_DRYRUN=
# The instant the Apps Script stopped booking (ISO 8601). Written at the flip to
# forwarder mode; the first live worker pass uses it to split the shadow backlog
# into "v1 already booked this" and "nobody booked this". With it unset the
# cutover refuses to touch either side. Can also live in the `cutoverV1StoppedAt`
# AutomationSetting row, which takes precedence.
CUTOVER_V1_STOPPED_AT=
# Native booking — opt-IN ("true"), and SEPARATE from QBO_RECEIPT_PUSH_ENABLED on
# purpose. With the QuickBooks push OFF and this ON, booking writes the ProBuild
# Expense (the job cost) with NO QuickBooks call at all: ProBuild owns receipts
# and job costing, QuickBooks is the bank feed the bookkeeper works from. Identity
# is ReceiptIntake.expenseId (@unique), so a re-run links rather than double-books.
# Dry run still outranks it: RECEIPT_INTAKE_DRYRUN books nothing either way, and so
# does the Command Center pause (`receiptPushPaused`), which is the no-redeploy
# brake on this rail — paused means nothing books, natively or otherwise.
# It also changes the CUTOVER, and only while the push is actually off (both
# switches on = the QuickBooks rail, cutover included): a pre-boundary Drive row
# with no v1 evidence is parked for a human instead of requeued, because the
# QuickBooks idempotency that made requeueing safe is not in play when nothing is
# sent to QuickBooks. That park is ONE-WAY — it takes the row off the shadow
# switch, so no later cutover pass revisits it and turning the push back on does
# NOT requeue it. It lands in the Receipts tab under Needs review, carrying
# `native-pre-cutover-unverified`, and a person ends it: "Set job" books it
# natively, "Void" records that the old system already booked it.
RECEIPT_BOOK_NATIVE=

# --- Receipt Pipeline v2 phase 2 (docs/plans/PHASE-2-QUEUE-AND-MEMOS-SPEC.md) ---
# The Google Chat INCOMING WEBHOOK for the "Receipts Need Review" space
# (spaces/AAQAKhvMYtg). UNSET = no card is posted and the cron answers
# "no-webhook" — the feature fails soft rather than erroring every morning.
# CONSEQUENCE OF THE WEBHOOK CHOICE: an incoming webhook posts as itself and
# cannot READ the space, so replies come back through the Apps Script bridge
# (affidavit-threads.json / chat-job-answers.json), never from the Chat API.
RECEIPTS_CHAT_WEBHOOK=
# Owner → Chat user id. JSON object; ids must start with "users/".
# NOT COSMETIC (round-39 gate, finding 4): the id is @-mentioned on the card AND
# exported as `owner_user` in the threads bridge, which is what the affidavit
# app checks before it lets somebody sign a memo for that owner. UNSET or
# unparseable = cards still post with plain names, and nobody but Justin can
# sign from them.
# Example: {"CJ":"users/123456789012345678901","Richard":"users/987654321098765432109"}
RECEIPT_OWNER_CHAT_USERS=
# The per-owner daily card cron. Ships DISABLED: it must be EXACTLY the string
# "true" before a single card goes out. Anything else (including unset) is off.
RECEIPT_REQUEST_CARDS_ENABLED=
# Mint canonical BankLine rows from unmatched QBO register observations. Ships
# DISABLED and must be EXACTLY "true" to enable. Left off, the bank statement
# stays the only thing that mints a line — which is the safe default, because
# `amountCents` is immutable by trigger once a row exists.
BANK_LINE_MINT_FROM_QBO=

# --- Google Drive (REQUIRED for signed memos — Phase 2 §4) -------------------
# The signed-memo path READS Drive file metadata to prove the affidavit PDF
# exists before it closes a chase. With no loadable credential the answers
# endpoint refuses every memo with 503 `drive-not-configured` and
# /api/health/pipeline reports the same reason. It never falls back to
# accepting one unverified.
#
# The Drive client (src/lib/gmail-client.ts) uses a DEDICATED OAuth client and
# falls back to the web-login one:
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Its authorized redirect URI must include, in production:
#   https://probuild.goldentouchremodeling.com/api/gmail/callback
#
# THE CREDENTIAL ITSELF comes from one of two places, and prod needs one:
#   1. An ADMIN completes the connect flow at /api/gmail/callback and grants the
#      `https://www.googleapis.com/auth/drive` scope. That stores the refresh
#      token in CompanySettings.googleDriveRefreshToken, which survives deploys
#      and is what `ensureDriveAuth()` reads. PREFERRED — no secret to copy.
#   2. Or paste that refresh token here. The local token file
#      (.gmail-token.json) only exists in development; Vercel's filesystem is
#      ephemeral, so on prod this variable and the stored credential are the
#      only two options.
GMAIL_REFRESH_TOKEN=

# --- Payroll (Phase 5) -------------------------------------------------------
# Payroll period configuration (src/lib/payroll-config.ts). ALL OPTIONAL — the
# built-in defaults are shown, and they are DEFAULTS PENDING JUSTIN'S DECISION
# (Phase 5 spec section 7, risks 2 and 3), not settled policy. Not secrets.
# PAYROLL_WEEK_START moves the PAY PERIOD boundary only; WA overtime stays a
# Mon-Sun workweek rule in src/lib/overtime.ts.
PAYROLL_PERIOD=biweekly
PAYROLL_WEEK_START=monday
# Comma-separated. Salaried staff are excluded from the Gusto SUMMARY csv (they
# are already paid a salary) but kept in the DETAIL csv for job costing.
# DEFAULTS TO EMPTY — NOBODY is guessed as salaried. Leave it blank unless an
# operator has confirmed who Gusto pays a salary: naming someone here drops
# their hours from the pay run, so a wrong guess silently underpays them. The
# User.payType column is the durable answer; this is the override.
PAYROLL_SALARIED_EMAILS=

# --- Cron heartbeat pings (src/lib/cron-heartbeat.ts) ------------------------
# One dead man's switch URL per money-touching cron (Healthchecks.io or
# compatible: POSTs `<url>/start` at the top of the run, `<url>` on success,
# `<url>/fail` with a short reason on error). Each is EXACTLY
# `HC_PING_URL_<JOB_KEY>` for its route below — all nine are OPTIONAL and
# independent: an unset one is a silent no-op for that job only, nothing fails
# or logs because it's missing.
HC_PING_URL_QUICKBOOKS_PAYMENTS=
HC_PING_URL_QBO_EXPENSES_SYNC=
HC_PING_URL_QBO_MAINTENANCE=
HC_PING_URL_BANK_REGISTER_PULL=
HC_PING_URL_CO_BILLING_SWEEP=
HC_PING_URL_PAYMENT_REMINDERS=
HC_PING_URL_RECEIPT_INTAKE_WORKER=
HC_PING_URL_RECEIPT_REQUESTS=
HC_PING_URL_RECEIPT_REQUEST_CARDS=
HC_PING_URL_SPEED_TO_LEAD=

# --- Speed-to-Lead v1 (PB-leads-001) — see docs/plans/SPEED-TO-LEAD-SPEC.md --
# Mode: OFF, TEST or LIVE. Anything else (including unset) is OFF. LIVE only
# has effect on production, and only after Justin activates it for the
# current code fingerprint (src/lib/speed-to-lead/fingerprint.ts).
SPEED_TO_LEAD_MODE=
# The only account allowed to approve, edit, regenerate, send-again, promote,
# mark junk, approve a template, clear a suppression, run readiness, activate
# LIVE, or change settings (spec Approval "Who").
SPEED_TO_LEAD_APPROVER_EMAIL=
# Shared secret for the site's signed webhook (HMAC-SHA256 over
# `timestamp.body` — src/lib/speed-to-lead/hmac.ts).
SPEED_TO_LEAD_WEBHOOK_SECRET=
# Signs the readiness runner's own test intake (spec Release "Test identity") —
# never derived from a form field.
LEAD_INGEST_TEST_SECRET=
# "on" enables the REAL (non-test) Template A per-message eligibility check
# (spec Release R4). The test-fixture template ignores this flag.
SPEED_TO_LEAD_TEMPLATE_A=
# Comma-separated recipient emails TEST mode / any isTest lead may ever be
# sent to (spec Dispatch "Kill switch", Release "Test identity").
SPEED_TO_LEAD_TEST_ALLOWLIST=
# Optional: caps sends per UTC day across all Speed-to-Lead outreach. Unset =
# no cap.
SPEED_TO_LEAD_DAILY_CAP=
# ntfy.sh topic (or compatible self-hosted base URL below) for the push to
# Justin (spec Goal 3). Falls back to the Leads Chat webhook if unset/failed.
SPEED_TO_LEAD_NTFY_TOPIC=
SPEED_TO_LEAD_NTFY_BASE_URL=
SPEED_TO_LEAD_CHAT_WEBHOOK_URL=
# The site's From address for the connect@ contact-form email, so the inbox
# poll can tell a fallback copy apart from everything else in gtrsupport@.
SPEED_TO_LEAD_WEBSITE_FROM_ADDRESS=
# JSON array of {"fromAddress","signingDomain"} the inbox poll trusts (spec
# Intake "Authenticate") — populated from real samples captured at R0.
# Defaults to voice-noreply@google.com / google.com only.
SPEED_TO_LEAD_TRUSTED_SENDERS=
# Overrides the built-in service-area city/zip defaults (spec Triage) without
# a redeploy. Comma-separated.
SPEED_TO_LEAD_SERVICE_AREA_CITIES=
SPEED_TO_LEAD_SERVICE_AREA_ZIP_PREFIXES=
# The readiness runner's own test-lead recipient (must also be on
# SPEED_TO_LEAD_TEST_ALLOWLIST).
SPEED_TO_LEAD_READINESS_TEST_EMAIL=
# Written by scripts/speed-to-lead-fingerprint.mjs (a "prebuild" npm hook)
# into .env.production.local — do not set this by hand.
SPEED_TO_LEAD_FINGERPRINT=
